.filters{
    display:flex; 
    justify-content:flex-end; 
    margin-bottom:12px
    }

.listing{
    display:grid; 
    grid-template-columns:1fr 320px; 
    gap:18px;
    }

.sidebar{
    background:var(--card); 
    padding:12px; 
    border-radius:12px
    }

.products-grid{
    display:grid; 
    grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); 
    gap:14px;
    }

.price{
    color:var(--accent); 
    font-weight:600
    }
